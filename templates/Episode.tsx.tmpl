import React from "react";
import { useVideoConfig } from "remotion";
import words from "../__SLUG__.captions.json";
import { C, EpisodeShell, GearG, Label, LOOP_FRAMES, PILLARS, Pill, Shot, Stage, cue, ease, makeAt, pop, useG } from "../brand";

/**
 * __NAME__ — generated by scripts/new-episode.sh. Starts from a working skeleton (renders as-is), then:
 *  1. fill episodes/__SLUG__/brief.md and shots.md (style brief + shot table; `python3 scripts/lint_shots.py __SLUG__`)
 *  2. replace the placeholder <Subject/> with ONE persistent subject; beats = camera moves + state changes, not slides
 *  3. anchor every beat to spoken words with at("phrase") — makeAt throws if the phrase is not in the captions
 * Rules (docs/STYLE_BRIEF.md + docs/ACCEPTANCE.md): no fades between sections, ≤2 text levels, text ≥30 px (Label throws),
 * stage y 290–1190, verdict pills in the Shot `hud` (screen space), a beat every ≤3 s, punches only on reveals.
 */
const P = PILLARS.__PILLAR__;

/** sentence starts (frames) — a generic beat grid until the episode is storyboarded */
const sentenceStarts = (fps: number) => {
  const out = [Math.round(words[0].start * fps)];
  words.forEach((w, i) => { if (/[.?!]$/.test(w.text) && words[i + 1]) out.push(Math.round(words[i + 1].start * fps)); });
  return out;
};

/** Placeholder persistent subject: replace with the episode's mechanism. Depends only on useG() (frozen at frame 0 for the loop). */
const Subject: React.FC<{ title?: string }> = ({ title }) => {
  const f = useG();
  const { fps } = useVideoConfig();
  const ss = sentenceStarts(fps);
  const k = ss.filter((s) => f >= s).length; // which sentence we are in
  return (
    <Stage>
      <g transform="translate(540 700)"><GearG r={230} color={P.color} rot={f * 1.5} /></g>
      <g transform={`translate(${540 + 250} ${700 - 230})`}><GearG r={110} color={C.amber} rot={-f * 3.1} /></g>
      <Label x={540} y={1060} text={title ?? `BEAT ${k}`} size={48} color={C.paper} o={ease(f, ss[k - 1] ?? 0, (ss[k - 1] ?? 0) + 8)} />
    </Stage>
  );
};

const Verdict: React.FC<{ at: number; text: string }> = ({ at, text }) => {
  const f = useG();
  const { fps } = useVideoConfig();
  return <Stage><Pill x={540} y={1150} w={560} text={text} color={C.amber} s={pop(f, at, fps)} /></Stage>;
};

export const __COMP__Video: React.FC = () => {
  const { fps, durationInFrames: D } = useVideoConfig();
  const at = makeAt(words, fps);
  const ss = sentenceStarts(fps);
  const card = at("That's the mechanism"), fin = ss.find((s) => s > card) ?? card + 30, loop = D - LOOP_FRAMES;
  const body = ss.filter((s) => s > 0 && s < card);
  const third = (i: number) => body[Math.min(body.length - 1, Math.floor((body.length * i) / 3))] ?? 30 * (i + 1);
  const [b1, b2, b3] = [third(0), third(1), third(2)];
  const cues = [cue(4, "pop", 0.8), ...body.map((s) => cue(s, "tick", 0.6)), cue(b1 - 5, "whoosh"), cue(b2 - 5, "whoosh"), cue(b3 - 5, "whoosh"), cue(b3 + 20, "pop", 0.8)];
  const cam = (a: number) => [{ at: a + 10, kind: "push" as const, s: 1.08 }, { at: a + 50, kind: "glide" as const, s: 1.04, x: -40 }, { at: a + 90, kind: "pull" as const, s: 1.0, x: 0 }];
  return (
    <EpisodeShell audio="__SLUG__.wav" words={words} pillar={P} ep="__EP__" source="__SOURCE__" cardAt={card} cardUntil={fin} cues={cues} hook={<Subject title="__HOOK__" />}
      chapters={[{ at: 0, label: "HOOK" }, { at: b1, label: "PART 1" }, { at: b2, label: "PART 2" }, { at: b3, label: "PART 3" }]}>
      <Shot from={0} to={b1} inT="none" outT="push" cam={[{ at: 0, kind: "push", s: 1.06, dur: 40 }, { at: Math.max(45, b1 - 30), kind: "punch", s: 1.15 }]}><Subject title="__HOOK__" /></Shot>
      <Shot from={b1} to={b2} inT="push" outT="whip" cam={cam(b1)}><Subject /></Shot>
      <Shot from={b2} to={b3} inT="whip" outT="whipUp" cam={cam(b2)}><Subject /></Shot>
      <Shot from={b3} to={card} inT="whipUp" outT="push" cam={cam(b3)} hud={<Verdict at={b3 + 20} text="THE MECHANISM" />}><Subject /></Shot>
      <Shot from={fin} to={loop} inT="push" outT="whip"><Subject title="__HOOK__" /></Shot>
    </EpisodeShell>
  );
};
