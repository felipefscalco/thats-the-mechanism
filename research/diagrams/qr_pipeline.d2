direction: down
vars: { d2-config: { theme-id: 200 } }
url: "LINK\nyoutube.com/@…" { style: { fill: "#15171D"; stroke: "#4CC9F0"; font-color: "#F3EFE6"; border-radius: 16; font-size: 30 } }
bytes: "DATA BYTES" { style: { fill: "#15171D"; stroke: "#4CC9F0"; font-color: "#F3EFE6"; border-radius: 16; font-size: 30 } }
rs: "REED–SOLOMON\n+ REPAIR BYTES" { style: { fill: "#FFB020"; stroke: "#FFB020"; font-color: "#0D0E12"; border-radius: 16; font-size: 30; bold: true } }
qr: "QR (LEVEL H)\n~30% REBUILDABLE" { style: { fill: "#15171D"; stroke: "#7BD389"; font-color: "#F3EFE6"; border-radius: 16; font-size: 30 } }
url -> bytes: "cut" { style: { stroke: "#F3EFE6"; font-color: "#9AA0AA"; font-size: 24 } }
bytes -> rs: "math" { style: { stroke: "#F3EFE6"; font-color: "#9AA0AA"; font-size: 24 } }
rs -> qr { style: { stroke: "#F3EFE6" } }
